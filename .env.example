# Public site URL (no trailing slash). Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://mailisto.com

# Supabase project (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Not required by the app. Never expose it to the browser or commit it.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional fallback Calendly link for the "Book a call" option on /contact.
# The value set in Admin -> Settings takes priority.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-name/30min
